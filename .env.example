# .env.example
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual credentials.
# .env is in .gitignore — NEVER commit credentials to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Snowflake credentials ──────────────────────────────────────────────────────
# Account identifier format: <orgname>-<accountname>
# Find yours in Snowflake UI → Admin → Accounts
SNOWFLAKE_ACCOUNT=your_org-your_account

SNOWFLAKE_USER=OLIST_SVC_USER
SNOWFLAKE_PASSWORD=ChangeMe123!

SNOWFLAKE_DATABASE=OLIST_DB
SNOWFLAKE_WAREHOUSE=OLIST_WH
SNOWFLAKE_ROLE=OLIST_ROLE

# ── dbt settings (used by Airflow worker) ─────────────────────────────────────
DBT_TARGET=prod           # prod | dev
DBT_PROJECT_DIR=/opt/airflow/dbt
DBT_PROFILES_DIR=/opt/airflow/dbt
